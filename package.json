{
  "name": "opc-console-ui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "format": "prettier --write src tests scripts *.js *.json *.html README.md",
    "format:check": "prettier --check src tests scripts *.js *.json *.html README.md",
    "typecheck": "tsc --noEmit",
    "start:local": "node scripts/start-local.mjs",
    "check:local": "node scripts/start-local.mjs --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
